# Copiez ce fichier en ".env" et remplissez les valeurs depuis votre projet Supabase
# (Dashboard Supabase → Project Settings → API).
# La clé "anon" est publique par conception : ne mettez jamais la clé "service_role" ici.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mode vocal temps réel : adresse HTTPS du moteur vocal (dossier prototypes/vocal-live publié, ex. sur Netlify). Facultatif.
EXPO_PUBLIC_VOCAL_ENGINE_URL=https://votre-site.netlify.app/

# Vocal du chat (micro, mode vocal) : désactivé par défaut. Mettre 1 pour le réactiver.
# EXPO_PUBLIC_VOICE_ENABLED=1
