# Copiez ce fichier en ".env" et remplissez les valeurs depuis votre projet Supabase
# (Dashboard Supabase → Project Settings → API).
# La clé "anon" est publique par conception : ne mettez jamais la clé "service_role" ici.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
